# ⚠️ هاد الملف للإنتاج (السيرفر)، مختلف عن .env.example المستخدم محلياً.
# انسخه باسم .env على السيرفر وعدّل كل القيم.

# اسم المضيف (host) هون لازم يكون "postgres" (اسم الخدمة بـ docker-compose.prod.yml)، مش localhost
POSTGRES_PASSWORD=غيّر_هاد_لباسوورد_قوي_وعشوائي
DATABASE_URL="postgresql://souq:غيّر_هاد_لباسوورد_قوي_وعشوائي@postgres:5432/souq_db?schema=public"

NODE_ENV=production
PORT=3000

# النطاق أو الـ subdomain اللي كادي رح يولّد له شهادة HTTPS تلقائياً
# لو ما عندك دومين بعد، استخدم nip.io مع الـ IP العام من أوراكل، مثال:
# لو الـ IP تبعك 130.61.45.12 → DOMAIN=130-61-45-12.nip.io
DOMAIN=your-domain-or-ip.nip.io

JWT_ACCESS_SECRET=ولّد_قيمة_عشوائية_طويلة_هون
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ولّد_قيمة_عشوائية_طويلة_مختلفة_هون
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

FREE_LISTINGS_COUNT=3
LISTING_PRICE_SYP=10

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FCM_NEW_LISTINGS_TOPIC=new_listings
