// مخطط قاعدة البيانات - سوقنا (Souq Al-Hay API)
// يغطي: المصادقة، الإعلانات، المحادثات، المحفظة (شام كاش)، البلاغات، الإشعارات

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ المستخدمون والمصادقة ============

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique // بصيغة دولية: +9639xxxxxxxx
  name          String?
  avatarUrl     String?
  role          Role     @default(USER)
  isVerified    Boolean  @default(false) // توثيق رقم الهاتف
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  walletBalance Int      @default(0) // بالليرة السورية، بوحدات صحيحة

  // نظام تسعير الإعلانات: أول 3 إعلانات مجانية، وبعدها إما من رصيد باقة أو دفع لكل إعلان
  freeListingsUsed         Int @default(0)
  packageListingsRemaining Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings           Listing[]
  messages           Message[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  walletTransactions WalletTransaction[]
  reportsSubmitted   Report[]            @relation("ReporterRelation")
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  paymentRequests    PaymentRequest[]
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ الإعلانات ============

enum ListingStatus {
  AWAITING_PAYMENT // أول 3 إعلانات مجانية استهلكت، وما في باقة فعّالة - بانتظار دفع شام كاش
  PENDING          // الدفع تأكد (أو إعلان مجاني/ضمن باقة) - بانتظار مراجعة المحتوى من الأدمن
  ACTIVE
  SOLD
  EXPIRED
  REJECTED
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique // أثاث، إلكترونيات...
  slug     String    @unique
  listings Listing[]
}

model Area {
  id       String    @id @default(uuid())
  city     String // دمشق
  district String // المزة، ركن الدين...
  listings Listing[]

  @@unique([city, district])
}

model Listing {
  id            String        @id @default(uuid())
  sellerId      String
  categoryId    String
  areaId        String
  title         String
  description   String
  priceSyp      Int
  status        ListingStatus @default(PENDING)
  isVerifiedTag Boolean       @default(false) // شارة "رقم موثّق" على صاحب الإعلان
  boostedUntil  DateTime? // ترقية الإعلان (إعلان مميز) حتى هذا التاريخ
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User           @relation(fields: [sellerId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  area          Area           @relation(fields: [areaId], references: [id])
  images          ListingImage[]
  conversations   Conversation[]
  reports         Report[]
  paymentRequests PaymentRequest[]

  @@index([status, categoryId, areaId])
  @@index([boostedUntil])
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  url       String
  position  Int     @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ============ المحادثات ============

model Conversation {
  id        String   @id @default(uuid())
  listingId String?
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages Message[]

  @@unique([listingId, buyerId, sellerId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ============ المحفظة والمدفوعات (شام كاش) ============

enum TransactionType {
  TOPUP      // شحن رصيد
  PROMOTION  // ترقية إعلان
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model WalletTransaction {
  id           String             @id @default(uuid())
  userId       String
  type         TransactionType
  amountSyp    Int
  status       TransactionStatus  @default(PENDING)
  shamCashRef  String? // رقم العملية المرجعي من مزوّد شام كاش
  metadata     Json? // أي بيانات إضافية (مثلاً معرّف الإعلان المرقّى)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// ============ الدفع اليدوي عبر شام كاش (باقات + دفع لكل إعلان) ============

enum PaymentPurpose {
  LISTING // دفع لإعلان واحد (بعد استهلاك الإعلانات المجانية ولا باقة فعّالة)
  PACKAGE // شراء باقة إعلانات
}

enum PaymentRequestStatus {
  PENDING   // بانتظار تأكيد الأدمن إنه المبلغ وصل فعلياً بتطبيق شام كاش
  CONFIRMED
  REJECTED
}

model Package {
  id            String   @id @default(uuid())
  name          String // مثال: "باقة 20 إعلان"
  listingsCount Int
  priceSyp      Int
  isActive      Boolean  @default(true)

  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id         String               @id @default(uuid())
  userId     String
  purpose    PaymentPurpose
  amountSyp  Int
  status     PaymentRequestStatus @default(PENDING)
  listingId  String? // محدد لو purpose = LISTING
  packageId  String? // محدد لو purpose = PACKAGE
  senderNote String? // المستخدم بيكتب فيه رقم هاتفه بشام كاش أو أي ملاحظة تساعد الأدمن يطابق العملية
  reviewedByAdminId String?
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())

  user    User     @relation(fields: [userId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  package Package? @relation(fields: [packageId], references: [id])

  @@index([status])
}

// صف واحد فقط (singleton) يحمل معلومات استلام الدفعات - رقم شام كاش وصورة الـ QR
model PaymentSettings {
  id                 String   @id @default("singleton")
  shamCashPhone      String
  shamCashHolderName String
  qrImageUrl         String?
  updatedAt          DateTime @updatedAt
}

// ============ البلاغات والإشعارات ============

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  listingId  String?
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User     @relation("ReporterRelation", fields: [reporterId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM device token
  platform  String // android / ios
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
