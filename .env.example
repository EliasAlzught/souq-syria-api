# قاعدة البيانات (تطابق إعدادات docker-compose.yml)
DATABASE_URL="postgresql://souq:souq_dev_password@localhost:5432/souq_db?schema=public"

NODE_ENV=development
PORT=3000

# JWT - غيّر هاي القيم بالإنتاج لقيم عشوائية طويلة وسرّية
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# TODO عند ربط بوابة SMS حقيقية (موفر محلي سوري أو Twilي)، أضف مفاتيحها هون
# SMS_PROVIDER_API_KEY=

# تسعير الإعلانات (بالليرة السورية الجديدة)
FREE_LISTINGS_COUNT=3
LISTING_PRICE_SYP=10

# Firebase Admin SDK (لإرسال إشعارات Push) - القيم الثلاث من ملف Service Account JSON
# لا تضع ملف الـ JSON نفسه هون، فقط انسخ القيم الثلاث منه. لا تشارك هاي القيم مع أي أحد.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# مهم: لو القيمة فيها أسطر جديدة (\n)، خليها بين علامتي اقتباس متل المثال:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
# اسم الـ topic اللي كل أجهزة المستخدمين مشتركة فيه لاستقبال إشعار "إعلان جديد"
FCM_NEW_LISTINGS_TOPIC=new_listings
